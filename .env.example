# Flask
SECRET_KEY=change-me

# MySQL
# If MySQL runs locally, use DB_PORT=3306.
# If MySQL runs from docker-compose, use DB_PORT=3307 from the host.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=photomanager

# Alibaba Cloud DashScope / Qwen
API_KEY=sk-your-qwen-api-key

# Amap web service
AMAP_KEY=your-amap-key

# Semantic image search: local python run.py + Docker Milvus
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
SIGLIP_MODEL_NAME=google/siglip-base-patch16-224
SIGLIP_DEVICE=auto

# Semantic embedding worker
SEMANTIC_INDEX_WORKER_ENABLED=true
SEMANTIC_INDEX_BATCH_SIZE=2
SEMANTIC_INDEX_POLL_SECONDS=10
SEMANTIC_INDEX_MAX_ATTEMPTS=3

# Milvus HNSW tuning
MILVUS_COLLECTION=photomanager_siglip_images
MILVUS_HNSW_M=16
MILVUS_HNSW_EF_CONSTRUCTION=200
MILVUS_HNSW_EF_SEARCH=64
SEMANTIC_CANDIDATE_MULTIPLIER=5
SEMANTIC_MAX_TOP_K=20
